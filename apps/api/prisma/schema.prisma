generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  ATENDENTE
  CLIENTE
  FINANCEIRO
  RECEPCIONISTA
}

model Usuario {
  id             String    @id @default(uuid())
  nome           String
  rua            String?
  bairro         String?
  cidade         String?
  estado         String?
  cep            String?
  dataNascimento DateTime?
  numeroCelular  String    @unique
  email          String?   @unique
  passwordHash   String?   @map("password_hash")
  avatarUrl      String?   @map("avatar_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tokens            Token[]
  owns_organizacoes Organizacao[]
  membros           Membro[]

  agendamentos_cliente      Agendamento[] @relation("ClienteAgendamentos")
  agendamentos_profissional Agendamento[] @relation("ProfissionalAgendamentos")

  @@map("usuarios")
}

model Organizacao {
  id              String   @id @default(uuid())
  cnpj            String   @unique
  razaoSocial     String   @unique
  nome            String
  slug            String   @unique
  rua             String
  bairro          String
  cidade          String
  estado          String
  cep             String
  avatarUrl       String?  @map("avatar_url")
  intervaloAgenda Int      @default(30)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner        Usuario       @relation(fields: [ownerId], references: [id])
  ownerId      String        @map("owner_id")
  membros      Membro[]
  servicos     Servico[]
  agendamentos Agendamento[]

  @@map("organizacoes")
}

enum TipoMembro {
  CLIENTE
  FUNCIONARIO
}

model Membro {
  id   String     @id @default(uuid())
  role Role
  tipo TipoMembro

  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId String      @map("organizacao_id")

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String  @map("usuario_id")

  expedientes Expediente[]

  @@unique([organizacaoId, usuarioId])
  @@map("membros")
}

enum TipoToken {
  PASSORD_RECOVER
  OTP_ACCESS
}

model Token {
  id        String    @id @default(uuid())
  tipo      TipoToken
  otpNumber BigInt?
  createdAt DateTime  @default(now()) @map("created_at")

  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  usuarioId String  @map("usuario_id")

  @@map("tokens")
}

model Servico {
  id        String @id @default(uuid())
  nome      String
  descricao String
  tempo     Int
  valor     Float

  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId String      @map("organizacao_id")

  agendamentos Agendamento[]

  @@map("servicos")
}

enum StatusAgendamento {
  AGENDADO
  CONFIRMADO
  CANCELADO
  CONCLUIDO
}

model Agendamento {
  id        String            @id @default(uuid())
  dataHora  DateTime
  status    StatusAgendamento @default(AGENDADO)
  valor     Float
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  servico   Servico @relation(fields: [servicoId], references: [id], onDelete: Cascade)
  servicoId String  @map("servico_id")

  cliente   Usuario @relation("ClienteAgendamentos", fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String  @map("cliente_id")

  profissional   Usuario @relation("ProfissionalAgendamentos", fields: [profissionalId], references: [id], onDelete: Cascade)
  profissionalId String  @map("profissional_Id")

  organizacao   Organizacao @relation(fields: [organizacaoId], references: [id], onDelete: Cascade)
  organizacaoId String      @map("organizacao_id")

  @@map("agendamentos")
}

model Expediente {
  id                  String   @id @default(uuid())
  nome                String
  expedientePrincipal Boolean
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  membroProfissional Membro @relation(fields: [membroId], references: [id], onDelete: Cascade)
  membroId           String @map("profissional_Id")

  diasExpediente DiasExpediente[]

  @@map("expedientes")
}

model DiasExpediente {
  id              String   @id @default(uuid())
  diaSemana       Int
  inicio          String
  fim             String
  inicioIntervalo String?
  fimIntervalo    String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  expedienteId String     @map("expediente_id")

  @@unique([expedienteId, diaSemana])
  @@map("diasExpediente")
}
